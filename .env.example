# Copy to .env (never commit .env). The API refuses to start if a required value is missing.

# --- runtime ---
ENVIRONMENT=local                  # local | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                # true in staging/production (HTTPS)

# --- required ---
# docker compose overrides DATABASE_URL / REDIS_URL with the container hostnames.
DATABASE_URL=postgresql+asyncpg://foodscore:foodscore@localhost:5432/foodscore
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# --- AI extraction ---
# fake = replay recorded fixtures (no key, no cost). Not allowed in production.
LLM_PROVIDER=fake                  # gemini | claude | fake
LLM_FALLBACK_PROVIDER=             # optional second provider used on outage
FAKE_FIXTURE=auto                  # auto | chocolate_biscuit | masala_noodles | cola_drink | rolled_oats | ...
PROMPT_VERSION=v1
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium               # low | medium | high
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low           # lowest the model allows; flash-lite models also take minimal
LLM_TIMEOUT_S=60

# --- quotas (user story 6) ---
USER_DAILY_SCAN_QUOTA=20
GUEST_DAILY_SCAN_QUOTA=3
GLOBAL_DAILY_SCAN_BUDGET=2000

# --- storage (local disk by default; docker compose uses MinIO) ---
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_DIR=.data/images
S3_BUCKET=foodscore-images
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- jobs ---
JOB_MODE=arq                       # arq (separate worker) | inline (single process, dev only)

# --- observability ---
SENTRY_DSN=
RELEASE=dev
